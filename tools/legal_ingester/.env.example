# Legal KB ingester configuration — copy to `.env` and fill in.
# NEVER commit the filled-in .env (it is gitignored).

# ── Required ────────────────────────────────────────────────────────────
# Your Convex deployment URL (same project as the app; the "cloud" host).
CONVEX_URL=https://gregarious-malamute-537.convex.cloud
# Shared secret — MUST match the LEGAL_INGEST_TOKEN environment variable
# set in the Convex dashboard (Settings → Environment Variables).
LEGAL_INGEST_TOKEN=

# ── Raw artifact storage (optional — Cloudflare R2) ─────────────────────
# Without these, artifacts cache in a local content-addressed directory.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Local artifact cache location (used when R2 is not configured)
ARTIFACTS_DIR=./artifacts

# ── Embeddings (optional — 768-dim vectors) ─────────────────────────────
# Without a key, ingestion is keyword-only (sparse search works; the
# dense vector leg stays dormant until you add a key).
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small

# ── Politeness (spec defaults; hard floor of 3s is enforced in code) ────
MAX_WORKERS=2
POLITENESS_MIN_S=3.0
POLITENESS_MAX_S=6.0
REQUEST_TIMEOUT_S=45

# Polite crawler identity — keep a real contact address in here.
USER_AGENT=PracticePro-LegalKB/1.0 (+polite crawler; contact: founders@practicepro.ng)
