# ====================================================================
# PracticePro Environment Variables Template
# ====================================================================
# Copy this file as .env.local and fill in your actual values.
# NEVER commit .env.local or any file with real API keys to version control.
# 
# Variable Naming Convention:
#   VITE_ prefix  → Exposed to the frontend (browser bundle). 
#                   NEVER put secrets in VITE_ variables.
#   No prefix     → Server-side only (Convex backend).
# ====================================================================

# --- Convex Backend ---
# Your Convex project URL (found in Convex dashboard → Settings)
VITE_CONVEX_URL=https://your-project.convex.cloud
VITE_CONVEX_SITE_URL=https://your-project.convex.site

# Internal Convex URL (same as above, used by the CLI)
CONVEX_URL=https://your-project.convex.cloud

# Convex deployment identifier (auto-generated by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-project-name

# Convex deployment key (found in Convex dashboard → Settings → API Keys)
# WARNING: This grants write access to your Convex backend. Keep it secret.
CONVEX_DEPLOY_KEY=dev:your-project-name|your-deploy-key

# --- Google Gemini AI ---
# API key for Gemini AI (used by ALOA agents, DraftPro, Research Studio)
# Get one at: https://aistudio.google.com/apikey
# WARNING: VITE_ prefixed keys are visible in the browser bundle.
# For production, move AI calls to Convex actions (server-side).
API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# --- Transactional Email (Brevo) ---
# Used for: verification emails, password resets, client notifications
BREVO_API_KEY=xkeysib-your-actual-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
PracticePro_Vega_Mailer=your_brevo_api_key_here

# --- WhatsApp Integration (Chakra / Meta API) ---
# Used for: automated resident reminders and revenue protection alerts
CHAKRA_ACCESS_TOKEN=your_whatsapp_access_token
CHAKRA_PLUGIN_ID=your_plugin_id
CHAKRA_PHONE_NUMBER_ID=your_phone_id
CHAKRA_WA_API_VERSION=v19.0

# --- Crash Reporting (Sentry) ---
# Create a free account at https://sentry.io → new React project → copy DSN
VITE_SENTRY_DSN=https://your-key@sentry.io/your-project

# --- Product Analytics (PostHog) ---
# Create a free account at https://posthog.com → new project → copy API key
VITE_POSTHOG_KEY=phc_your-api-key
# Only needed if self-hosting PostHog:
# VITE_POSTHOG_HOST=https://your-posthog-instance.com

# ====================================================================
# Payment Gateways (CRO Audit Track A/B)
# ====================================================================
# Paystack is fully coded but DORMANT until these env vars are set.
# Until then, the active payment provider is 'manual' (bank transfer).
# See convex/paystack.ts and convex/payments.ts for implementation details.

# Flip to 'true' to activate Paystack card payments end-to-end.
PAYSTACK_ENABLED=false

# Your Paystack secret key (server-side only — NEVER expose to frontend).
# Get one at: https://dashboard.paystack.co/api/keys
PAYSTACK_SECRET_KEY=sk_test_your-secret-key

# Your Paystack public key (safe to expose to frontend for Inline checkout).
PAYSTACK_PUBLIC_KEY=pk_test_your-public-key

# REQUIRED for Paystack callback_url. Must be the public URL of your app
# (e.g. https://app.practicepro.ng). Without this, card payments will fail
# with "SITE_URL environment variable is not configured".
SITE_URL=https://your-app-domain.com

# Optional: Convex deployment key for the founder admin dashboard
# (separate from CONVEX_DEPLOY_KEY above). Used by updateFirmAdminSettings
# to authenticate founder-only tier-flips.
# FOUNDER_TOKEN_IDENTIFIER=your-founder-email@example.com
