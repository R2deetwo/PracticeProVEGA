# ─── Frontend (REQUIRED for local dev) ──────────────────────────────────────
# Convex deployment URL — the backend this build talks to.
# Get it from `npx convex dev` (prints the URL) or your Convex dashboard.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ─── Frontend (OPTIONAL — features degrade gracefully when unset) ───────────
# Google Gemini API key — powers ALOA/ARIA AI chat, drafting, research,
# document analysis. Without it, AI features are hidden/disabled.
VITE_GEMINI_API_KEY=

# PostHog product analytics (landing-page funnels, event tracking)
VITE_POSTHOG_KEY=

# Sentry crash reporting (production error monitoring).
# Create a project at https://sentry.io → React → copy the DSN.
# Session replay is intentionally disabled (legal/financial data privacy).
VITE_SENTRY_DSN=

# ─── Backend / CI (OPTIONAL — for deploys from GitHub Actions) ──────────────
# Convex deploy key — lets CI deploy backend functions.
# Set as a GitHub Actions secret, not usually needed locally.
CONVEX_DEPLOY_KEY=

# Firebase Cloud Messaging — push notifications for the Android APKs
FCM_SERVER_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Vercel token for the direct-deploy helper script (scripts/vercel-deploy.cjs)
VERCEL_TOKEN=

# Local Prisma-style sandbox DB used by some dev tooling (not the app DB)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Android Release Signing (REQUIRED for production APK builds) ───────────
# These environment variables must be set before running:
#   npm run apk:release       (user APK  — com.practicepro.app)
#   npm run apk:admin:release (founder APK — com.practicepro.admin)
#
# The keystore file (release.keystore) lives at android/app/release.keystore
# and is gitignored. Generate it locally using keytool.
#
# For the founder APK build, set RELEASE_KEY_ALIAS=practicepro-admin
# For the user APK build,  set RELEASE_KEY_ALIAS=practicepro-app
#
# If these are NOT set, the build falls back to debug signing (with a warning).
# This is fine for local dev/testing but will NOT be accepted by Google Play.

RELEASE_STORE_FILE=android/app/release.keystore
RELEASE_STORE_PASSWORD=your-keystore-password-here
RELEASE_KEY_ALIAS=practicepro-app
RELEASE_KEY_PASSWORD=your-key-password-here
