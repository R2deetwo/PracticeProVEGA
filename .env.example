# ─── Android Release Signing (REQUIRED for production APK builds) ──────────
# These environment variables must be set before running:
#   npm run apk:release      (user APK — com.practicepro.app)
#   npm run apk:admin:release (founder APK — com.practicepro.admin)
#
# The keystore file (release.keystore) lives at android/app/release.keystore
# and is gitignored. Generate it locally using keytool.
#
# For the founder APK build, set RELEASE_KEY_ALIAS=practicepro-admin
# For the user APK build, set RELEASE_KEY_ALIAS=practicepro-app
#
# If these are NOT set, the build falls back to debug signing (with a warning).
# This is fine for local dev/testing but will NOT be accepted by Google Play.

RELEASE_STORE_FILE=android/app/release.keystore
RELEASE_STORE_PASSWORD=your-keystore-password-here
RELEASE_KEY_ALIAS=practicepro-app
RELEASE_KEY_PASSWORD=your-key-password-here
