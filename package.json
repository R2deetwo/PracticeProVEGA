{
  "name": "practice-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:staging": "vite --host --mode staging",
    "dev:prod": "vite --host --mode production",
    "prebuild": "node scripts/generate-version-manifest.cjs",
    "build": "vite build && node scripts/mark-healthy.cjs",
    "audit:app": "npx tsx scripts/agent-audit.ts",
    "audit:all": "npx tsx scripts/audit-master-suite.ts",
    "dev-report": "npx tsx scripts/generate-dev-report.ts",
    "build:staging": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "deploy": "npx convex deploy && vite build",
    "deploy:staging": "npx convex dev --once --env-file .env.staging && npm run build:staging",
    "deploy:prod": "npx convex dev --once --env-file .env.production && npm run build:prod",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "build:admin": "npx vite build --config vite.admin.config.ts",
    "cap:sync:admin": "npm run build:admin && node scripts/sync-admin-config.cjs",
    "cap:open:admin": "node scripts/sync-admin-config.cjs --open",
    "apk:admin:debug": "npm run cap:sync:admin && cd android && ./gradlew assembleDebug",
    "apk:admin:release": "npm run cap:sync:admin && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/inter": "^5.2.8",
    "@google/genai": "^2.8.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@sentry/react": "^10.59.0",
    "@tiptap/extension-character-count": "^3.20.0",
    "@tiptap/extension-color": "^3.20.0",
    "@tiptap/extension-font-family": "^3.20.0",
    "@tiptap/extension-highlight": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-subscript": "^3.20.0",
    "@tiptap/extension-superscript": "^3.20.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-table-cell": "^3.20.0",
    "@tiptap/extension-table-header": "^3.20.0",
    "@tiptap/extension-table-row": "^3.20.0",
    "@tiptap/extension-task-item": "^3.20.0",
    "@tiptap/extension-task-list": "^3.20.0",
    "@tiptap/extension-text-align": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@types/quill": "^2.0.14",
    "convex": "^1.32.0",
    "date-fns": "^3.0.0",
    "dompurify": "^3.0.0",
    "drizzle-zod": "^0.8.3",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.300.0",
    "mammoth": "^1.12.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "posthog-js": "^1.391.2",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.21.0",
    "three": "^0.184.0",
    "uuid": "^9.0.1",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.1",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
