<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!-- ─── FCM notification defaults (2026-09-14 round 2) ───────────
             Without these meta-data entries, any FCM 'notification' payload
             that fails to resolve its icon field falls back to Android's
             generic white-circle-with-'i' badge — the "badge shows a
             circle with an 'i' rather than my iconography" complaint.
             ic_notification is an alpha-only drawable (res/drawable) that
             the system can tint; ic_launcher is a mipmap and is NOT a valid
             small-icon resource for FCM. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- ─── WHATSAPP-GRADE PUSH (2026-09-14) ────────────────────────
             The stock @capacitor/push-notifications MessagingService only
             relays messages to JS — it never posts anything itself, so
             data-only FCM messages (the payload shape that enables
             MessagingStyle stacking + inline reply) would be invisible.

             Our PracticeProMessagingService REPLACES the plugin's service
             as the MESSAGING_EVENT handler (tools:node="remove" strips the
             library declaration from the merged manifest so exactly ONE
             service receives FCM events). It posts the tray notification in
             EVERY app state, adds the reply action for conversational
             pushes, and still forwards to the plugin's static bridge so
             JS listeners keep firing. See
             java/com/practicepro/app/push/PracticeProMessagingService.java. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".push.PracticeProMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Inline-reply handler: receives the RemoteInput text from the
             notification's Reply action, POSTs to /api/push-reply with the
             server-minted replyToken, and updates the notification. -->
        <receiver
            android:name=".push.PushReplyReceiver"
            android:exported="false" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- POST_NOTIFICATIONS — required for Android 13+ (API 33+) push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- RECORD_AUDIO — required for voice notes, ALOA voice chat, and client intake recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- CAMERA — required for document scanning and photo capture (future use) -->
    <uses-permission android:name="android.permission.CAMERA" />
</manifest>
