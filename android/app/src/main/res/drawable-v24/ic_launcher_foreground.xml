<!-- PracticePro launcher icon foreground — professional brand mark.

     Design philosophy: Clean, geometric, modern SaaS app icon.
     The "P" is constructed from precise geometric shapes:
       - A clean vertical stem (rectangle)
       - A perfect semicircle bowl that connects seamlessly to the stem
       - The negative space inside the bowl creates the distinctive P shape

     Color: Emerald #10B981 (matches app primary-600)
     Background: White full-bleed for clean adaptive icon rendering
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">

    <!-- White full-bleed background -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Emerald rounded square (safe zone: 22-86 = 64x64dp) -->
    <!-- Larger than before for a more prominent, confident brand mark -->
    <path
        android:fillColor="#10B981"
        android:pathData="M22,22 L86,22 Q90,22 90,26 L90,82 Q90,86 86,86 L22,86 Q18,86 18,82 L18,26 Q18,22 22,22 Z" />

    <!-- White "P" — constructed from two precise geometric shapes -->

    <!-- Vertical stem: clean rectangle, 8dp wide, centered at x=46 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,34 L50,34 L50,74 L42,74 Z" />

    <!-- Upper bowl: perfect rounded rectangle connected to stem -->
    <!-- The bowl is 18dp wide (50-68), 18dp tall (34-52), with 9dp radius corners -->
    <!-- The inner cutout creates the open P shape -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,34 L60,34 Q68,34 68,43 Q68,52 60,52 L50,52 Z" />

    <!-- Inner cutout: emerald circle that creates the P's open bowl -->
    <!-- This makes the P look clean and intentional, not hand-drawn -->
    <path
        android:fillColor="#10B981"
        android:pathData="M50,40 L58,40 Q62,40 62,43 L62,47 Q62,48 60,48 L50,48 Z" />
</vector>
