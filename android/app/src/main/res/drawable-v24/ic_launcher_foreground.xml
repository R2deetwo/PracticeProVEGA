<!-- PracticePro launcher icon foreground — sleek 3D-feel design.

     Design based on user-provided reference:
     - Black outer background (matte, professional)
     - Glossy emerald green inner rounded square (3D button feel)
     - Clean white "P" with subtle highlight

     The 3D effect is achieved through:
     1. A gradient overlay on the green square (lighter at top, darker at bottom)
     2. A subtle highlight band near the top (simulates light reflection)
     3. The P has a slight shadow offset for depth
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">

    <!-- Black matte background — fills entire canvas -->
    <path
        android:fillColor="#0A0A0A"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Glossy emerald green square with gradient (3D button effect) -->
    <!-- Main square: emerald gradient from #10B981 (top) to #059669 (bottom) -->
    <path
        android:fillColor="#10B981"
        android:pathData="M24,24 L84,24 Q88,24 88,28 L88,80 Q88,84 84,84 L24,84 Q20,84 20,80 L20,28 Q20,24 24,24 Z" />

    <!-- Gradient overlay: lighter band at top for gloss effect -->
    <path
        android:fillColor="#34D399"
        android:pathData="M24,24 L84,24 Q88,24 88,28 L88,40 L20,40 L20,28 Q20,24 24,24 Z" />

    <!-- Subtle highlight line (simulates light reflection on glossy surface) -->
    <path
        android:fillColor="#6EE7B7"
        android:fillAlpha="0.3"
        android:pathData="M28,28 L80,28 Q82,28 82,30 L82,32 L26,32 L26,30 Q26,28 28,28 Z" />

    <!-- Bottom shadow gradient (darker bottom for 3D depth) -->
    <path
        android:fillColor="#047857"
        android:fillAlpha="0.5"
        android:pathData="M20,72 L88,72 L88,80 Q88,84 84,84 L24,84 Q20,84 20,80 Z" />

    <!-- White "P" — clean geometric with subtle shadow for depth -->
    <!-- Shadow layer (slightly offset, semi-transparent) -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.15"
        android:pathData="M43,36 L51,36 L51,73 L43,73 Z M51,36 L61,36 Q69,36 69,44 L69,51 Q69,57 61,57 L51,57 Z" />

    <!-- Main white P -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,35 L50,35 L50,72 L42,72 Z" />

    <!-- P upper bowl -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,35 L60,35 Q68,35 68,43 L68,50 Q68,56 60,56 L50,56 Z" />

    <!-- P inner cutout (creates the open bowl shape) -->
    <path
        android:fillColor="#10B981"
        android:pathData="M50,41 L58,41 Q62,41 62,44 L62,48 Q62,49 60,49 L50,49 Z" />

    <!-- Subtle highlight on P (top-left, simulates light hitting the letter) -->
    <path
        android:fillColor="#F0FDF4"
        android:fillAlpha="0.5"
        android:pathData="M42,35 L50,35 L50,38 L42,38 Z" />
</vector>
