{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "practice-pro-vega",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
    // NOTE (2026-08-31): a `cache_control` block used to live here but wrangler
    // has NEVER supported `assets.cache_control` — every deploy logged
    // "Unexpected fields found in assets field: cache_control" and silently
    // ignored it. Removed to stop the warning.
    //
    // Cache strategy relies on default Workers-Assets behavior (etag +
    // must-revalidate) PLUS per-deploy CSS URL rotation (see the
    // bust-css-asset-names plugin in vite.config.ts). Cloudflare's edge for
    // workers.dev domains does not purge entries when a new version deploys,
    // so any URL that once served the SPA fallback (HTML) can stay poisoned
    // at an edge PoP. Rotating the CSS filename per deploy guarantees no
    // build ever reuses a URL that a previous deploy's fallback could have
    // poisoned. The entry JS already rotates per build by design
    // (VITE_BUILD_TIMESTAMP is baked into the bundle).
  },
  "observability": {
    "enabled": true
  }
}
